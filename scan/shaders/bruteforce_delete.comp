// BruteForce Delete Compute Shader
// Clears valid bit for entries at specified row indices
#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint count;           // Number of entries to delete
    uint padding;
    uvec2 dataBufferAddr; // 64-bit buffer device address
} pc;

// Buffer reference for data entries (16 bytes each: x, y, z, rowId)
layout(buffer_reference, std430, buffer_reference_align = 16) buffer DataEntryRef {
    uvec4 entry;
};

// Row indices to delete
layout(std430, binding = 0) readonly buffer RowIdBuffer {
    uint rowIds[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.count) return;
    
    // Get the row index to delete
    uint rowId = rowIds[idx];
    
    // Compute address of this entry using buffer device address
    uint64_t baseAddr = uint64_t(pc.dataBufferAddr.x) | (uint64_t(pc.dataBufferAddr.y) << 32);
    uint64_t entryAddr = baseAddr + uint64_t(rowId) * 16u;  // 16 bytes per entry
    
    // Read entry, clear valid bit, write back
    DataEntryRef dataRef = DataEntryRef(entryAddr);
    uvec4 entry = dataRef.entry;
    entry.w &= 0x7FFFFFFFu;  // Clear valid bit (MSB)
    dataRef.entry = entry;
}
