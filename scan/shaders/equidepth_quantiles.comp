// Equi-Depth Binning: Step 3 - Extract Quantile Boundaries from CDF
// Input: CDF arrays (prefix-summed histograms)
// Output: Quantile boundary arrays (1025 values for 1024 bins)
#version 450
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 256) in;

layout(push_constant) uniform ConstantBlock {
    uint npoints;
    uint coarseBins;      // e.g., 4096
    uint finalBins;       // e.g., 1024 (INDEX_RESOLUTION)
    uint minX;
    uint maxX;
    uint minY;
    uint maxY;
} consts;

// Input: CDF arrays (prefix-summed histograms, exclusive scan)
// CDF[i] = number of points with value < boundary[i]
layout(std430, binding = 0) readonly buffer CDFX {
    uint cdfX[];
};

layout(std430, binding = 1) readonly buffer CDFY {
    uint cdfY[];
};

// Output: Quantile boundaries (finalBins + 1 values each)
// quantileX[i] = value such that i/finalBins fraction of points have x < quantileX[i]
layout(std430, binding = 2) writeonly buffer QuantilesX {
    uint quantileX[];
};

layout(std430, binding = 3) writeonly buffer QuantilesY {
    uint quantileY[];
};

// Binary search to find smallest j such that cdf[j] >= target
uint findQuantileBin(uint target, uint cdfBase, bool isX) {
    uint lo = 0;
    uint hi = consts.coarseBins;
    
    while (lo < hi) {
        uint mid = (lo + hi) / 2;
        uint cdfVal;
        if (isX) {
            cdfVal = cdfX[mid];
        } else {
            cdfVal = cdfY[mid];
        }
        
        if (cdfVal < target) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    
    // We need to compute finalBins + 1 quantile boundaries
    if (gid > consts.finalBins) return;
    
    uint rangeX = consts.maxX - consts.minX;
    uint rangeY = consts.maxY - consts.minY;
    if (rangeX == 0) rangeX = 1;
    if (rangeY == 0) rangeY = 1;
    
    // Target rank for this quantile: gid / finalBins * npoints
    // For gid=0: target=0 (min value)
    // For gid=finalBins: target=npoints (max value)
    uint64_t targetRank = (uint64_t(gid) * uint64_t(consts.npoints)) / uint64_t(consts.finalBins);
    uint target = uint(targetRank);
    
    // Find coarse bin for X
    uint coarseBinX = findQuantileBin(target, 0, true);
    // Convert coarse bin to actual value
    // value = minX + coarseBinX * (rangeX + 1) / coarseBins
    uint valueX;
    if (gid == 0) {
        valueX = consts.minX;
    } else if (gid == consts.finalBins) {
        valueX = consts.maxX + 1; // Upper bound exclusive
    } else {
        valueX = consts.minX + uint((uint64_t(coarseBinX) * uint64_t(rangeX + 1)) / uint64_t(consts.coarseBins));
    }
    quantileX[gid] = valueX;
    
    // Find coarse bin for Y
    uint coarseBinY = findQuantileBin(target, 0, false);
    uint valueY;
    if (gid == 0) {
        valueY = consts.minY;
    } else if (gid == consts.finalBins) {
        valueY = consts.maxY + 1; // Upper bound exclusive
    } else {
        valueY = consts.minY + uint((uint64_t(coarseBinY) * uint64_t(rangeY + 1)) / uint64_t(consts.coarseBins));
    }
    quantileY[gid] = valueY;
}
