// Compact Index - Scale Counts by INITIAL_SCALE_FACTOR
// Run after count pass, before prefix sum
// This reserves extra space per bin for future updates

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 1) buffer CountBuffer {
    uint count[];
};

layout(push_constant) uniform PushConstants {
    uint totalBins;
    uint scaleFactor; // INITIAL_SCALE_FACTOR (e.g., 2)
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    
    if (gid >= pc.totalBins) return;
    
    // Scale count by factor to reserve space
    // Minimum 1 slot if count > 0 (to handle edge cases)
    uint c = count[gid];
    if (c > 0) {
        count[gid] = c * pc.scaleFactor;
    }
}
