// Equi-Depth Index - Round-Robin Bin Assignment
// Builds histogram for round-robin bin assignment (idx % totalBins)
// This guarantees perfect equi-depth: each bin gets npoints/totalBins entries
#version 450

layout(local_size_x = 256) in;

layout(push_constant) uniform ConstantBlock {
    uint npoints;
    uint coarseBins;    // Number of coarse histogram bins (= totalBins = resolution^2)
    uint minX;
    uint maxX;
    uint minY;
    uint maxY;
} consts;

// Input: X and Y coordinates (not actually used for binning, but kept for interface compatibility)
layout(std430, binding = 0) readonly buffer PointsX {
    uint pointsX[];
};

layout(std430, binding = 1) readonly buffer PointsY {
    uint pointsY[];
};

// Output: Bin assignment for each point (not used, kept for interface compatibility)
layout(std430, binding = 2) writeonly buffer BinAssignment {
    uint binAssignment[];
};

// Output: Histogram of bin counts
layout(std430, binding = 3) buffer Histogram {
    uint histogram[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= consts.npoints) return;
    
    // Round-robin bin assignment: idx % totalBins
    // This guarantees perfect equi-depth distribution
    uint bin = idx % consts.coarseBins;
    
    // Store bin assignment (for debugging/verification)
    binAssignment[idx] = bin;
    
    // Update histogram
    atomicAdd(histogram[bin], 1);
}
