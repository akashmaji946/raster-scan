#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_ARB_gpu_shader_int64 : require

// CompactBruteScan Update Shader
// Update = delete from main buffer + insert to aux buffer with SAME rowID
// One thread per update request

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct CompactBruteEntry {
    uint x;
    uint y;
    uint z;
    uint rowId;
};

// Buffer references
layout(buffer_reference, std430, buffer_reference_align = 16) buffer MainDataRef {
    CompactBruteEntry data;
};

layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer AuxDataRef {
    uvec4 data;
};

layout(std430, binding = 0) buffer StartAddrBuffer {
    uint startAddr[];
};

layout(std430, binding = 1) buffer ExtentBuffer {
    uint extent[];
};

layout(std430, binding = 2) readonly buffer UpdateDataBuffer {
    uint updatePoints[]; // [x, y, z] triples - same point for delete and insert
};

layout(std430, binding = 3) buffer AuxCountBuffer {
    uint auxCount;
};

layout(push_constant) uniform PushConstants {
    uint minX; uint minY; uint minZ;
    uint resolution;
    uint binWidthX; uint binWidthY; uint binWidthZ;
    uint nupdates;
    uint auxCapacity;
    uint pad;
    uvec2 mainBufferAddr;
    uvec2 auxBufferAddr;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.nupdates) return;
    
    uint64_t mainBaseAddr = uint64_t(pc.mainBufferAddr.x) | (uint64_t(pc.mainBufferAddr.y) << 32);
    uint64_t auxBaseAddr = uint64_t(pc.auxBufferAddr.x) | (uint64_t(pc.auxBufferAddr.y) << 32);
    
    // Read point to update
    uint dx = updatePoints[gid * 3 + 0];
    uint dy = updatePoints[gid * 3 + 1];
    uint dz = updatePoints[gid * 3 + 2];
    
    // Determine bin
    uint bx = 0;
    if (dx >= pc.minX) {
        bx = (dx - pc.minX) / pc.binWidthX;
    }
    if (bx >= pc.resolution) bx = pc.resolution - 1;
    
    uint by = 0;
    if (dy >= pc.minY) {
        by = (dy - pc.minY) / pc.binWidthY;
    }
    if (by >= pc.resolution) by = pc.resolution - 1;
    
    uint binIdx = by * pc.resolution + bx;
    uint cnt = extent[binIdx];
    uint start = startAddr[binIdx];
    
    // Linear scan of bin - find matching entry, get its rowID, delete, then insert to aux
    for (uint i = 0; i < cnt; i++) {
        uint idx = start + i;
        
        uint64_t byteOffset = uint64_t(idx) * 16u;
        uint64_t elementAddr = mainBaseAddr + byteOffset;
        MainDataRef dataRef = MainDataRef(elementAddr);
        
        uint ex = dataRef.data.x;
        uint ey = dataRef.data.y;
        uint ez = dataRef.data.z;
        
        if (ex == dx && ey == dy && ez == dz) {
            uint currentRowId = dataRef.data.rowId;
            
            if ((currentRowId & 0x80000000u) != 0u) {
                // Extract the actual rowID (we'll reuse it)
                uint actualRowId = currentRowId & 0x7FFFFFFFu;
                
                // Try to invalidate
                uint newRowId = actualRowId; // Clear valid bit
                uint oldRowId = atomicCompSwap(dataRef.data.rowId, currentRowId, newRowId);
                
                if (oldRowId == currentRowId) {
                    // Successfully deleted - now insert to aux with same rowID
                    uint slot = atomicAdd(auxCount, 1);
                    if (slot < pc.auxCapacity) {
                        uint64_t auxOffset = uint64_t(slot) * 16u;
                        uint64_t auxAddr = auxBaseAddr + auxOffset;
                        AuxDataRef auxRef = AuxDataRef(auxAddr);
                        auxRef.data = uvec4(dx, dy, dz, actualRowId | 0x80000000u);
                    }
                    return;
                }
            }
        }
    }
}
