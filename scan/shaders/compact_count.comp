#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_vote : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 1) buffer CountBuffer {
    uint count[];
};

layout(std430, binding = 3) buffer PointsBuffer {
    uint points[];
};

layout(push_constant) uniform PushConstants {
    uint minX; uint minY; uint minZ;
    uint resolution;
    uint maxX; uint maxY; uint maxZ;
    uint npoints;
    uint binWidthX; uint binWidthY; uint binWidthZ;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    
    // Bounds check
    bool isActive = (gid < pc.npoints);
    uint binIdx = 0;
    
    if (isActive) {
        // Read point (Column Major: [X... | Y... | Z...])
        uint x = points[gid];
        uint y = points[gid + pc.npoints];
        uint z = points[gid + 2 * pc.npoints];

        // Determine bin
        uint bx = 0;
        if (x >= pc.minX) {
            bx = (x - pc.minX) / pc.binWidthX;
        }
        if (bx >= pc.resolution) bx = pc.resolution - 1;
        
        uint by = 0;
        if (y >= pc.minY) {
            by = (y - pc.minY) / pc.binWidthY;
        }
        if (by >= pc.resolution) by = pc.resolution - 1;
        
        binIdx = by * pc.resolution + bx;
    }
    
    // Subgroup Aggregation
    // Loop until all active threads have processed their bin
    while (subgroupAny(isActive)) {
        // Pick the highest bin index among active threads (avoids dynamic broadcast issue)
        // If a thread is inactive, it contributes 0.
        // Since loop condition ensures at least one active thread, max will be valid.
        uint targetBin = subgroupMax(isActive ? binIdx : 0);
        
        // Check which threads map to this bin
        bool isTarget = isActive && (binIdx == targetBin);
        
        if (isTarget) {
            // Count how many threads map to this bin
            // subgroupAdd reduces over all active invocations in this control flow block
            uint aggCount = subgroupAdd(1);
            
            // Leader performs single atomic add
            if (subgroupElect()) {
                atomicAdd(count[targetBin], aggCount);
            }
            
            // Mark these threads as done
            isActive = false;
        }
    }
}
