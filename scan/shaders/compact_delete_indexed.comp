#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_ARB_gpu_shader_int64 : require

// O(1) delete using index mapping
// Each thread handles one delete request
// Uses indexMap[pointIndex] to directly find the data entry
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Buffer reference for rowId field (we only need 4-byte atomic on rowId)
layout(buffer_reference, std430, buffer_reference_align = 4) buffer RowIdRef {
    uint value;
};

layout(std430, binding = 3) buffer DeleteIndicesBuffer {
    uint deleteIndices[];  // Original point indices to delete
};

// Binding 8: Index Map - maps pointIndex → globalDataIndex
layout(std430, binding = 8) buffer IndexMapBuffer {
    uint indexMap[];
};

layout(push_constant) uniform PushConstants {
    uint ndeletes;
    uvec2 dataBufferAddr;  // 64-bit buffer device address (split)
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.ndeletes) return;
    
    // Get the original point index to delete
    uint pointIndex = deleteIndices[gid];
    
    // Look up the global data index directly - O(1)
    uint dataIndex = indexMap[pointIndex];
    
    // Check if valid (might have been deleted already)
    if (dataIndex == 0xFFFFFFFF) return;  // Already deleted or invalid
    
    // Compute rowId address via buffer device address + 64-bit pointer arithmetic
    uint64_t baseAddr = uint64_t(pc.dataBufferAddr.x) | (uint64_t(pc.dataBufferAddr.y) << 32);
    uint64_t byteOffset = uint64_t(dataIndex) * 16u + 12u;  // rowId field
    RowIdRef rowIdRef = RowIdRef(baseAddr + byteOffset);

    // Atomically clear the valid bit
    uint currentRowId = rowIdRef.value;
    if ((currentRowId & 0x80000000u) != 0u) {
        uint newRowId = currentRowId & 0x7FFFFFFFu;
        atomicCompSwap(rowIdRef.value, currentRowId, newRowId);
    }
    
    // Mark as deleted in index map (optional, for future lookups)
    // indexMap[pointIndex] = 0xFFFFFFFF;
}
