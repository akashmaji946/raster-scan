#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_ARB_gpu_shader_int64 : require

// CompactBruteScan Delete Shader - Multi-threaded version
// Deletes by data values (x,y,z) - searches BOTH main buffer (by bin) AND aux buffer (linear)
// Uses THREADS_PER_DELETE threads per delete request for parallel bin/aux scanning

#define THREADS_PER_DELETE 1024  // Number of threads collaborating per delete
#define LOCAL_SIZE 1024

layout(local_size_x = LOCAL_SIZE, local_size_y = 1, local_size_z = 1) in;

struct CompactBruteEntry {
    uint x;
    uint y;
    uint z;
    uint rowId;
};

// Buffer reference for >4GB buffer access
layout(buffer_reference, std430, buffer_reference_align = 16) buffer DataBufferRef {
    CompactBruteEntry data;
};

layout(std430, binding = 0) buffer StartAddrBuffer {
    uint startAddr[];
};

layout(std430, binding = 1) buffer ExtentBuffer {
    uint extent[];
};

layout(std430, binding = 2) buffer DeleteDataBuffer {
    uint deletePoints[]; // [x, y, z] triples
};

layout(push_constant) uniform PushConstants {
    uint minX; uint minY; uint minZ;
    uint resolution;
    uint binWidthX; uint binWidthY; uint binWidthZ;
    uint ndeletes;
    uvec2 mainBufferAddr;
    uvec2 auxBufferAddr;
    uint auxCount;  // Current count in aux buffer
} pc;

// Shared memory for early-exit flag per delete request in this workgroup
// Each workgroup handles 256/THREADS_PER_DELETE = 8 delete requests
shared uint foundFlag[LOCAL_SIZE / THREADS_PER_DELETE];

void main() {
    uint gid = gl_GlobalInvocationID.x;
    
    // Which delete request this thread is working on
    uint deleteId = gid / THREADS_PER_DELETE;
    // Which thread within the group for this delete
    uint threadInGroup = gid % THREADS_PER_DELETE;
    // Local index for shared memory (within workgroup)
    uint localDeleteId = gl_LocalInvocationID.x / THREADS_PER_DELETE;
    
    // Initialize shared flag (only first thread per delete)
    if (threadInGroup == 0) {
        foundFlag[localDeleteId] = 0;
    }
    barrier();
    
    if (deleteId >= pc.ndeletes) return;
    
    uint64_t mainBaseAddr = uint64_t(pc.mainBufferAddr.x) | (uint64_t(pc.mainBufferAddr.y) << 32);
    uint64_t auxBaseAddr = uint64_t(pc.auxBufferAddr.x) | (uint64_t(pc.auxBufferAddr.y) << 32);
    
    // Read point to delete (all threads in group read same point)
    uint dx = deletePoints[deleteId * 3 + 0];
    uint dy = deletePoints[deleteId * 3 + 1];
    uint dz = deletePoints[deleteId * 3 + 2];
    
    // ========== PHASE 1: Search in MAIN buffer (bin-based, parallel) ==========
    // Determine bin
    uint bx = 0;
    if (dx >= pc.minX) {
        bx = (dx - pc.minX) / pc.binWidthX;
    }
    if (bx >= pc.resolution) bx = pc.resolution - 1;
    
    uint by = 0;
    if (dy >= pc.minY) {
        by = (dy - pc.minY) / pc.binWidthY;
    }
    if (by >= pc.resolution) by = pc.resolution - 1;
    
    uint binIdx = by * pc.resolution + bx;
    uint cnt = extent[binIdx];
    uint start = startAddr[binIdx];
    
    // Parallel scan of bin - each thread handles strided entries
    for (uint i = threadInGroup; i < cnt; i += THREADS_PER_DELETE) {
        // Check if another thread already found it
        if (foundFlag[localDeleteId] != 0) break;
        
        uint idx = start + i;
        
        uint64_t byteOffset = uint64_t(idx) * 16u;
        uint64_t elementAddr = mainBaseAddr + byteOffset;
        DataBufferRef dataRef = DataBufferRef(elementAddr);
        
        uint ex = dataRef.data.x;
        uint ey = dataRef.data.y;
        uint ez = dataRef.data.z;
        
        if (ex == dx && ey == dy && ez == dz) {
            uint currentRowId = dataRef.data.rowId;
            
            if ((currentRowId & 0x80000000u) != 0u) {
                uint newRowId = currentRowId & 0x7FFFFFFFu;
                uint oldRowId = atomicCompSwap(dataRef.data.rowId, currentRowId, newRowId);
                
                if (oldRowId == currentRowId) {
                    // Signal other threads to stop
                    atomicExchange(foundFlag[localDeleteId], 1);
                    break;
                }
            }
        }
    }
    
    // Sync before checking if we need to search aux buffer
    barrier();
    
    // ========== PHASE 2: Search in AUX buffer (parallel scan) ==========
    // Only search aux if not found in main
    if (foundFlag[localDeleteId] == 0) {
        // Parallel scan of aux buffer
        for (uint i = threadInGroup; i < pc.auxCount; i += THREADS_PER_DELETE) {
            // Check if another thread already found it
            if (foundFlag[localDeleteId] != 0) break;
            
            uint64_t byteOffset = uint64_t(i) * 16u;
            uint64_t elementAddr = auxBaseAddr + byteOffset;
            DataBufferRef dataRef = DataBufferRef(elementAddr);
            
            uint ex = dataRef.data.x;
            uint ey = dataRef.data.y;
            uint ez = dataRef.data.z;
            
            if (ex == dx && ey == dy && ez == dz) {
                uint currentRowId = dataRef.data.rowId;
                
                if ((currentRowId & 0x80000000u) != 0u) {
                    uint newRowId = currentRowId & 0x7FFFFFFFu;
                    uint oldRowId = atomicCompSwap(dataRef.data.rowId, currentRowId, newRowId);
                    
                    if (oldRowId == currentRowId) {
                        // Signal other threads to stop
                        atomicExchange(foundFlag[localDeleteId], 1);
                        break;
                    }
                }
            }
        }
    }
}
