#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_vote : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct CompactEntry {
    uint x;
    uint y;
    uint z;
    uint rowId;
    uint pageId; // MSB is valid
    uint pad0;
    uint pad1;
    uint pad2;
};

layout(std430, binding = 0) buffer StartAddrBuffer {
    uint startAddr[];
};

layout(std430, binding = 1) buffer CountBuffer {
    uint count[];
};

layout(std430, binding = 2) buffer DataBuffer {
    CompactEntry data[];
};

layout(std430, binding = 3) buffer PointsBuffer {
    uint points[];
};

layout(std430, binding = 6) buffer CapacityBuffer {
    uint capacity[];
};

layout(push_constant) uniform PushConstants {
    uint minX; uint minY; uint minZ;
    uint resolution;
    uint maxX; uint maxY; uint maxZ;
    uint npoints;
    uint binWidthX; uint binWidthY; uint binWidthZ;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    
    bool isActive = (gid < pc.npoints);
    uint binIdx = 0;
    
    uint x = 0;
    uint y = 0;
    uint z = 0;
    
    if (isActive) {
        // Read point (Column Major: [X... | Y... | Z...])
        x = points[gid];
        y = points[gid + pc.npoints];
        z = points[gid + 2 * pc.npoints];

        // Determine bin
        uint bx = 0;
        if (x >= pc.minX) {
            bx = (x - pc.minX) / pc.binWidthX;
        }
        if (bx >= pc.resolution) bx = pc.resolution - 1;
        
        uint by = 0;
        if (y >= pc.minY) {
            by = (y - pc.minY) / pc.binWidthY;
        }
        if (by >= pc.resolution) by = pc.resolution - 1;
        
        binIdx = by * pc.resolution + bx;
    }
    
    // Subgroup Aggregation
    while (subgroupAny(isActive)) {
        // Pick the highest bin index among active threads
        uint targetBin = subgroupMax(isActive ? binIdx : 0);
        
        // Identify participants
        bool isTarget = isActive && (binIdx == targetBin);
        
        if (isTarget) {
            // How many threads for this bin?
            uint aggCount = subgroupAdd(1);
            
            // Get base offset for the group using one atomic
            uint groupBase = 0;
            if (subgroupElect()) {
                groupBase = atomicAdd(count[targetBin], aggCount);
            }
            groupBase = subgroupBroadcastFirst(groupBase);
            
            // Calculate thread-local offset
            uint localOffset = subgroupExclusiveAdd(1);
            
            // Global index
            uint start = startAddr[targetBin];
            uint globalIdx = start + groupBase + localOffset;
            
            // Write to data buffer
            CompactEntry entry;
            entry.x = x;
            entry.y = y;
            entry.z = z;
            entry.rowId = gid; // Original index as rowId
            entry.pageId = 0x80000000; // Valid bit set (MSB)
            entry.pad0 = 0;
            entry.pad1 = 0;
            entry.pad2 = 0;
            
            data[globalIdx] = entry;
            
            isActive = false;
        }
    }
}
