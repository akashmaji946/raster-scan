#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer StartAddrBuffer {
    uint startAddr[];
};

layout(std430, binding = 1) buffer CountBuffer {
    uint count[];
};

// Binding 2: Data buffer (using descriptor binding)
layout(std430, binding = 2) buffer DataBuffer {
    uvec4 data[];
};

layout(std430, binding = 3) buffer PointsBuffer {
    uint points[];
};

layout(std430, binding = 6) buffer CapacityBuffer {
    uint capacity[];
};

// Binding 7: extentBuffer - highest index written per bin
layout(std430, binding = 7) buffer ExtentBuffer {
    uint extent[];
};

layout(push_constant) uniform PushConstants {
    uint minX; uint minY; uint minZ;
    uint resolution;
    uint maxX; uint maxY; uint maxZ;
    uint npoints;
    uint binWidthX; uint binWidthY; uint binWidthZ;
    uint useRowMajor; // 0 = column-major (build), 1 = row-major (insert)
    uint scaleFactor; // COMPACT_INITIAL_SCALE_FACTOR for capacity calculation
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.npoints) return;
    
    // Read point based on layout
    uint x, y, z;
    if (pc.useRowMajor != 0u) {
        // Row-major: [x0, y0, z0, x1, y1, z1, ...]
        x = points[gid * 3 + 0];
        y = points[gid * 3 + 1];
        z = points[gid * 3 + 2];
    } else {
        // Column-major: [X... | Y... | Z...]
        x = points[gid];
        y = points[gid + pc.npoints];
        z = points[gid + 2 * pc.npoints];
    }

    // Determine bin
    uint bx = 0;
    if (x >= pc.minX) {
        bx = (x - pc.minX) / pc.binWidthX;
    }
    if (bx >= pc.resolution) bx = pc.resolution - 1;
    
    uint by = 0;
    if (y >= pc.minY) {
        by = (y - pc.minY) / pc.binWidthY;
    }
    if (by >= pc.resolution) by = pc.resolution - 1;
    
    uint binIdx = by * pc.resolution + bx;
    
    // Get slot in bin using atomic on extent buffer
    uint offsetInBin = atomicAdd(extent[binIdx], 1);
    
    // Check capacity before writing
    uint origCount = capacity[binIdx];
    uint binCapacity = origCount * pc.scaleFactor;
    
    if (offsetInBin < binCapacity) {
        // Global index
        uint start = startAddr[binIdx];
        uint globalIdx = start + offsetInBin;
        
        // Write to data buffer using descriptor binding
        data[globalIdx] = uvec4(x, y, z, gid | 0x80000000u);
    }
}
