#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_ARB_gpu_shader_int64 : require

// Simple delete: one thread per delete request, linear scan within bin
// For skewed distributions, this can be slow but is correct
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// CompactEntry: 4 uints (16 bytes) - same as RasterScan2D
// Valid bit is MSB of rowId (0x80000000)
struct CompactEntry {
    uint x;
    uint y;
    uint z;
    uint rowId;  // MSB is valid bit
};

// Buffer reference for >4GB data buffer access - single element for 64-bit pointer arithmetic
layout(buffer_reference, std430, buffer_reference_align = 16) buffer DataBufferRef {
    CompactEntry data;  // Single element, we'll use pointer arithmetic for 64-bit indexing
};

layout(std430, binding = 0) buffer StartAddrBuffer {
    uint startAddr[];
};

layout(std430, binding = 1) buffer CountBuffer {
    uint count[];
};

layout(std430, binding = 2) buffer DeleteDataBuffer {
    uint deletePoints[]; // [x, y, z] triples
};

// Binding 3: extentBuffer - highest index written per bin
// NOT modified on delete (entries not shifted, just marked invalid)
layout(std430, binding = 3) buffer ExtentBuffer {
    uint extent[];
};

layout(push_constant) uniform PushConstants {
    uint minX; uint minY; uint minZ;
    uint resolution;
    uint maxX; uint maxY; uint maxZ;
    uint ndeletes;
    uint binWidthX; uint binWidthY; uint binWidthZ;
    uint pad;  // padding for alignment
    uvec2 dataBufferAddr;  // 64-bit buffer device address
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.ndeletes) return;
    
    // Reconstruct 64-bit buffer base address from push constants
    uint64_t baseAddr = uint64_t(pc.dataBufferAddr.x) | (uint64_t(pc.dataBufferAddr.y) << 32);
    
    // Read point to delete
    uint dx = deletePoints[gid * 3 + 0];
    uint dy = deletePoints[gid * 3 + 1];
    uint dz = deletePoints[gid * 3 + 2];
    
    // Determine bin
    uint bx = 0;
    if (dx >= pc.minX) {
        bx = (dx - pc.minX) / pc.binWidthX;
    }
    if (bx >= pc.resolution) bx = pc.resolution - 1;
    
    uint by = 0;
    if (dy >= pc.minY) {
        by = (dy - pc.minY) / pc.binWidthY;
    }
    if (by >= pc.resolution) by = pc.resolution - 1;
    
    uint binIdx = by * pc.resolution + bx;
    uint cnt = extent[binIdx];  // Use extent (actual count), not count (prefix sum)
    uint start = startAddr[binIdx];
    
    // Linear scan of bin - find and delete ONE matching entry
    for (uint i = 0; i < cnt; i++) {
        uint idx = start + i;
        
        // Use 64-bit pointer arithmetic to bypass 4GB indexing limit
        // Each entry is 16 bytes (CompactEntry), so byte offset = idx * 16
        uint64_t byteOffset = uint64_t(idx) * 16u;
        uint64_t elementAddr = baseAddr + byteOffset;
        DataBufferRef dataRef = DataBufferRef(elementAddr);
        
        // Read coordinates via buffer reference (bypasses 4GB limit)
        uint ex = dataRef.data.x;
        uint ey = dataRef.data.y;
        uint ez = dataRef.data.z;
        
        // Check if coordinates match
        if (ex == dx && ey == dy && ez == dz) {
            // Try to atomically invalidate
            uint currentRowId = dataRef.data.rowId;
            
            // Check if valid
            if ((currentRowId & 0x80000000u) != 0u) {
                uint newRowId = currentRowId & 0x7FFFFFFFu;
                uint oldRowId = atomicCompSwap(dataRef.data.rowId, currentRowId, newRowId);
                
                if (oldRowId == currentRowId) {
                    // Successfully deleted - return immediately
                    return;
                }
                // If CAS failed, the entry was modified by another thread
                // It might have been invalidated, so continue searching
            }
        }
    }
}
