#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// CompactEntry: 4 uints (16 bytes) - same as RasterScan2D
// Valid bit is MSB of rowId (0x80000000)
struct CompactEntry {
    uint x;
    uint y;
    uint z;
    uint rowId;  // MSB is valid bit
};

layout(std430, binding = 0) buffer StartAddrBuffer {
    uint startAddr[];
};

layout(std430, binding = 1) buffer CountBuffer {
    uint count[];
};

layout(std430, binding = 2) buffer DataBuffer {
    CompactEntry data[];
};

layout(std430, binding = 3) buffer DeleteDataBuffer {
    uint deletePoints[]; // [x, y, z] triples
};

layout(push_constant) uniform PushConstants {
    uint minX; uint minY; uint minZ;
    uint resolution;
    uint maxX; uint maxY; uint maxZ;
    uint ndeletes;
    uint binWidthX; uint binWidthY; uint binWidthZ;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.ndeletes) return;
    
    // Read point to delete
    uint dx = deletePoints[gid * 3 + 0];
    uint dy = deletePoints[gid * 3 + 1];
    uint dz = deletePoints[gid * 3 + 2];
    
    // Determine bin
    uint bx = 0;
    if (dx >= pc.minX) {
        bx = (dx - pc.minX) / pc.binWidthX;
    }
    if (bx >= pc.resolution) bx = pc.resolution - 1;
    
    uint by = 0;
    if (dy >= pc.minY) {
        by = (dy - pc.minY) / pc.binWidthY;
    }
    if (by >= pc.resolution) by = pc.resolution - 1;
    
    uint binIdx = by * pc.resolution + bx;
    uint cnt = count[binIdx];
    uint start = startAddr[binIdx];
    
    // Linear scan of bin with race-condition safe deletion
    // Uses atomicCompSwap to ensure only one thread successfully invalidates each entry
    // If another thread invalidates an entry first, this thread sees it as invalid and moves on
    
    for (uint i = 0; i < cnt; i++) {
        uint idx = start + i;
        
        // Read coordinates first (these don't change)
        uint ex = data[idx].x;
        uint ey = data[idx].y;
        uint ez = data[idx].z;
        
        // Check if coordinates match
        if (ex == dx && ey == dy && ez == dz) {
            // Coordinates match - try to atomically invalidate
            // Loop until we either successfully invalidate or see it's already invalid
            while (true) {
                uint currentRowId = data[idx].rowId;
                
                // Check if already invalid (another thread got it first)
                if ((currentRowId & 0x80000000u) == 0u) {
                    // Already invalid, move on to find next matching entry
                    break;
                }
                
                // Try to atomically clear the valid bit
                uint newRowId = currentRowId & 0x7FFFFFFFu;
                uint oldRowId = atomicCompSwap(data[idx].rowId, currentRowId, newRowId);
                
                if (oldRowId == currentRowId) {
                    // Successfully invalidated this entry
                    // Continue scanning for duplicates (don't return)
                    break;
                }
                // else: another thread modified rowId, retry the check
            }
        }
    }
}
